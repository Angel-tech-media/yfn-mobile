{
  "expo": {
    "name": "Vibe",
    "slug": "vibe",
    "owner": "davidokpo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vibe",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.vibe.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Vibe needs access to your camera so you can capture photos and videos for products and reels.",
        "NSPhotoLibraryUsageDescription": "Vibe needs access to your photo library to let you select product images and reel media.",
        "NSMicrophoneUsageDescription": "Vibe needs access to your microphone when recording video reels."
      }
    },
    "android": {
      "package": "ng.vibe.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0E1F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vibe needs access to your photo library so you can choose media to upload.",
          "cameraPermission": "Vibe needs access to your camera so you can capture photos and videos to upload.",
          "microphonePermission": "Vibe needs access to your microphone when recording videos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0E1F",
          "dark": {
            "backgroundColor": "#0A0E1F"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2F6BFF"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1a1e0e87-189e-43ef-a2af-fd6d21364223"
      }
    }
  }
}
